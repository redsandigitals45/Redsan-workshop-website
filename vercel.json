{
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "redsandigitals.in"
        }
      ],
      "destination": "https://redsan.in/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.redsandigitals.in"
        }
      ],
      "destination": "https://redsan.in/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.redsan.in"
        }
      ],
      "destination": "https://redsan.in/$1",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/blog/index.html",
      "destination": "/blog/",
      "permanent": true
    },
    {
      "source": "/blog/blog-post.html",
      "destination": "/blog/",
      "permanent": true
    },
    {
      "source": "/blog/2nd-year-student-15000-retainer/(.*)",
      "destination": "/blog/how-redsan-helped-d2c-brand-scale-revenue/",
      "permanent": true
    },
    {
      "source": "/blog/2nd-year-student-15000-retainer/",
      "destination": "/blog/how-redsan-helped-d2c-brand-scale-revenue/",
      "permanent": true
    },
    {
      "source": "/blog/2nd-year-student-15000-retainer.html",
      "destination": "/blog/how-redsan-helped-d2c-brand-scale-revenue/",
      "permanent": true
    },
    {
      "source": "/blog/3-line-objection-handler/(.*)",
      "destination": "/blog/10-marketing-mistakes-indian-businesses-make/",
      "permanent": true
    },
    {
      "source": "/blog/3-line-objection-handler/",
      "destination": "/blog/10-marketing-mistakes-indian-businesses-make/",
      "permanent": true
    },
    {
      "source": "/blog/3-line-objection-handler.html",
      "destination": "/blog/10-marketing-mistakes-indian-businesses-make/",
      "permanent": true
    },
    {
      "source": "/blog/cold-dm-vs-warm-intro-vs-referral/(.*)",
      "destination": "/blog/google-ads-vs-meta-ads/",
      "permanent": true
    },
    {
      "source": "/blog/cold-dm-vs-warm-intro-vs-referral/",
      "destination": "/blog/google-ads-vs-meta-ads/",
      "permanent": true
    },
    {
      "source": "/blog/cold-dm-vs-warm-intro-vs-referral.html",
      "destination": "/blog/google-ads-vs-meta-ads/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "header",
          "key": "Accept",
          "value": "(.*text/html.*)"
        }
      ],
      "headers": [
        { "key": "Content-Type", "value": "text/html; charset=utf-8" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Content-Type", "value": "text/html; charset=utf-8" }
      ]
    },
    {
      "source": "/(.*)/",
      "headers": [
        { "key": "Content-Type", "value": "text/html; charset=utf-8" }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=3600" }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=3600" }
      ]
    },
    {
      "source": "/llms(.*).txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=3600" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/assets 2/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)\\.(css|js|webp|png|jpg|jpeg|svg|ico|avif)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }
      ]
    }
  ]
}
